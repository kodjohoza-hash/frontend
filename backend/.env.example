# ── Serveur ─────────────────────────────────────────
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

# ── CORS ────────────────────────────────────────────
# Origines autorisées, séparées par des virgules
CORS_ORIGINS=http://localhost:5173

# ── Devise ──────────────────────────────────────────
# Code ISO 4217 de la devise par défaut de la plateforme
DEFAULT_CURRENCY=XAF

# ── Base de données (MySQL / MariaDB) ───────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bus_tix_connect
DB_USER=root
DB_PASSWORD=
# true = sequelize.sync() au démarrage (dev uniquement)
DB_SYNC=false

# ── Authentification JWT ────────────────────────────
# Access token (durée courte) — secret obligatoire à changer en prod
JWT_SECRET=changez_moi_en_dev
JWT_REFRESH_SECRET=changez_moi_aussi_en_prod
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Sécurité Auth ───────────────────────────────────
# Verrouillage temporaire après échecs de connexion
AUTH_MAX_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
# Durées des jetons (email de vérification / réinitialisation)
VERIFY_TOKEN_EXPIRES_IN=24h
RESET_TOKEN_EXPIRES_IN=1h

# ── Upload ──────────────────────────────────────────
UPLOAD_DIR=uploads
UPLOAD_MAX_SIZE_MB=10

# ── SMTP (structure email — renseigner pour envoyer) ─
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@bustixconnect.com

# ── Cron ────────────────────────────────────────────
CRON_ENABLED=true
# Toutes les nuits à 02:00
CRON_SUBSCRIPTION_SCHEDULE=0 2 * * *

# ── Super Admin initial (seed) ──────────────────────
SEED_SUPER_ADMIN_EMAIL=admin@bustixconnect.com
SEED_SUPER_ADMIN_PASSWORD=Admin@2026
